@PACKAGE_INIT@

set (pars_config_targets_file @pars_config_targets_file@)

# set (THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency (Threads REQUIRED)
find_dependency (asio CONFIG REQUIRED)
find_dependency (flatbuffers CONFIG REQUIRED)
if (PARS_ENABLE_LOGGING)
	find_dependency (spdlog CONFIG REQUIRED)
else ()
	find_dependency (fmt CONFIG REQUIRED)
endif ()

include ("${CMAKE_CURRENT_LIST_DIR}/${pars_config_targets_file}")

check_required_components (pars)
